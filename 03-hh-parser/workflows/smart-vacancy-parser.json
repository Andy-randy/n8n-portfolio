      "parameters": {
        "jsCode": "const vacancies = items[0]?.json?.items ?? [];\n\nreturn vacancies.map((vacancy) => ({\n  json: {\n    название: vacancy.name ?? '',\n    компания: vacancy.employer?.name ?? '',\n    зарплата: vacancy.salary?.from ?? vacancy.salary?.to ?? null,\n    валюта: vacancy.salary?.currency ?? null,\n    ссылка: vacancy.alternate_url ?? '',\n    формат: vacancy.schedule?.name ?? '',\n    требования: vacancy.snippet?.requirement ?? '',\n    обязанности: vacancy.snippet?.responsibility ?? ''\n  }\n}));\n"
