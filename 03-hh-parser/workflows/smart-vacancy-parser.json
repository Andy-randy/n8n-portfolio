    {
      "parameters": {
        "jsCode": "const vacancies = items[0]?.json?.data ?? [];\n\nconst text = vacancies.length\n  ? vacancies.map((vacancy) =>\n      `📌 ${vacancy.название}\\n🏢 ${vacancy.компания}\\n💰 ${vacancy.зарплата ?? 'не указана'} ${vacancy.валюта ?? ''}\\n🤖 Score: ${vacancy.ai_score}/100 — ${vacancy.ai_summary}\\n🔗 ${vacancy.ссылка}`\n    ).join('\\n\\n---\\n\\n')\n  : 'Подходящих вакансий не найдено.';\n\nreturn [{ json: { текст: text } }];"
      },
