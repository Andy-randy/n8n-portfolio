    {
      "parameters": {
        "jsCode": "const raw = $json.output ?? '';\nlet cleaned = raw;\n\nif (typeof cleaned === 'string') {\n  cleaned = cleaned\n    .replace(/^```json\\s*/i, '')\n    .replace(/^```\\s*/i, '')\n    .replace(/```$/i, '')\n    .trim();\n}\n\ntry {\n  const parsed = typeof cleaned === 'string' ? JSON.parse(cleaned) : cleaned;\n  const score = Number(parsed?.score);\n  const verdicts = new Set(['strong_match', 'review', 'low_match']);\n\n  if (!Number.isFinite(score) || score < 0 || score > 100) {\n    throw new Error('invalid score');\n  }\n  if (!verdicts.has(parsed?.verdict)) {\n    throw new Error('invalid verdict');\n  }\n\n  return [{\n    json: {\n      ai_score: Math.round(score),\n      ai_verdict: parsed.verdict,\n      ai_strengths: Array.isArray(parsed.strengths) ? parsed.strengths : [],\n      ai_risks: Array.isArray(parsed.risks) ? parsed.risks : [],\n      ai_summary: String(parsed.summary || ''),\n      ai_error: false\n    }\n  }];\n} catch (error) {\n  return [{\n    json: {\n      ai_score: 0,\n      ai_verdict: 'review',\n      ai_strengths: [],\n      ai_risks: [],\n      ai_summary: 'AI assessment unavailable; review manually.',\n      ai_error: true\n    }\n  }];\n}"
      },
