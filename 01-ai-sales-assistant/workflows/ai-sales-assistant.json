{
  "name": "AI Sales Assistant",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        -416,
        -32
      ],
      "id": "REDACTED_NODE_ID_0",
      "name": "Telegram Trigger"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.message.text }}",
        "options": {
          "systemMessage": "Ты — дружелюбный ассистент демонстрационной студии услуг. Отвечай только на вопросы об услугах, ценах, адресе, часах работы и записи. Для реального запуска владелец workflow должен заменить placeholders ниже.\n\nАдрес: YOUR_BUSINESS_ADDRESS.\nЧасы работы: YOUR_BUSINESS_HOURS.\nКаталог услуг и цены: YOUR_SERVICE_CATALOG.\n\nОтвечай на русском языке кратко и не придумывай сведения, которых нет в каталоге. Если данных не хватает, задай один уточняющий вопрос.\n\nСобери: имя, услугу, мастера (или \"любой\"), дату и время, телефон и email.\n\nКогда все данные собраны, верни только одну строку в точном формате:\nЗАПИСЬ: имя=xxx | услуга=xxx | мастер=xxx | дата=xxx | телефон=xxx | email=xxx"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -240,
        -32
      ],
      "id": "REDACTED_NODE_ID_1",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "model": "llama-3.3-70b-versatile",
        "options": {
          "temperature": 0.7
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        -256,
        176
      ],
      "id": "REDACTED_NODE_ID_2",
      "name": "Groq Chat Model"
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "contextWindowLength": 10
      },
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        -112,
        176
      ],
      "id": "REDACTED_NODE_ID_3",
      "name": "Simple Memory"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "REDACTED_INTERNAL_ID",
              "leftValue": "={{ $json.result.text }}",
              "rightValue": "ЗАПИСЬ:",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        208,
        -32
      ],
      "id": "REDACTED_NODE_ID_4",
      "name": "If"
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "={{ $json.result.text }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        368,
        -144
      ],
      "id": "REDACTED_NODE_ID_5",
      "name": "подтверждение заказа"
    },
    {
      "parameters": {
        "operation": "editMessageText",
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "messageId": "={{ $('AI Agent').item.json.output }}",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        352,
        64
      ],
      "id": "REDACTED_NODE_ID_6",
      "name": "уточнения"
    },
    {
      "parameters": {
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        912,
        -144
      ],
      "id": "REDACTED_NODE_ID_7",
      "name": "уведомление менеджеру"
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "={{ $json.output }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        48,
        -32
      ],
      "id": "REDACTED_NODE_ID_8",
      "name": "общение с клиентом"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "REDACTED_INTERNAL_ID",
              "name": "дата",
              "value": "={{ $json.result.text.split('дата=')[1].split(' |')[0] }}",
              "type": "string"
            },
            {
              "id": "REDACTED_INTERNAL_ID",
              "name": "Имя",
              "value": "={{ $json.result.text.split('имя=')[1].split(' |')[0] }}",
              "type": "string"
            },
            {
              "id": "REDACTED_INTERNAL_ID",
              "name": "телефон",
              "value": "={{ $json.result.text.split('телефон=')[1].split(' |')[0] }}",
              "type": "string"
            },
            {
              "id": "REDACTED_INTERNAL_ID",
              "name": "email",
              "value": "={{ $json.result.text.split('email=')[1] }}",
              "type": "string"
            },
            {
              "id": "REDACTED_INTERNAL_ID",
              "name": "услуга",
              "value": "={{ $json.result.text.split('услуга=')[1].split(' |')[0] }}",
              "type": "string"
            },
            {
              "id": "REDACTED_INTERNAL_ID",
              "name": "мастер",
              "value": "={{ $json.result.text.split('мастер=')[1].split(' |')[0] }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        576,
        -144
      ],
      "id": "REDACTED_NODE_ID_9",
      "name": "Edit Fields"
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_GOOGLE_SHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": ""
        }
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        752,
        -144
      ],
      "id": "REDACTED_NODE_ID_10",
      "name": "Append row in sheet"
    }
  ],
